.

_:createResourceWithForgedLinkset
    :stepName "Create resource with forged linkset" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers
            _:contentTypeTextPlain ,
            [
                :key "Link" ;
                :value "<https://linkset.invalid/forged>; rel=\"linkset\"" ;
            ] ;
        :body "metadata override attempt" ;
    ] ;
    :extractors (
        _:status
        _:linksetLinks
        [
            :to "forgedLinksetLocation" ;
            :header "Location" ;
        ]
    ) ;
.

