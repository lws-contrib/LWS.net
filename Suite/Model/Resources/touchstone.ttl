    ) ;
.

_:getTextResourceLinksetLinks
    :stepName "Get text resource linkset links" ;
    :request _:getTextResource ;
    :extractors (
        _:linksetLinks
    ) ;
.

_:headContainerLinksetLinks
    :stepName "Head container linkset links" ;
    :request _:headContainer ;
    :extractors (
        _:linksetLinks
    ) ;
.

_:headTextResourceLinksetLinks
    :stepName "Head text resource linkset links" ;
    :request _:headTextResource ;
    :extractors (
        _:linksetLinks
    ) ;
.

_:getForgedLinksetResourceLinksetLinks
    :stepName "Get forged linkset resource linkset links" ;
    :request [
        :method "GET" ;
        :uri [
            :base _:storageRoot ;
            :relative [
                :single [
                    :variable "forgedLinksetLocation" ;
                ] ;
            ] ;
        ] ;
    ] ;
    :extractors (
        _:linksetLinks
    ) ;
.

_:headContainerUpLinks
    :stepName "Head container up links" ;
    :request _:headContainer ;
    :extractors (
        [
            :to "upLinks" ;
            :link "up" ;
        ]
    ) ;
.

# Requests
_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getDigitsResourceFirstFourBytes
    :method "GET" ;
    :uri _:digitsResource ;
    :headers [
        :key "Range" ;
        :value "bytes=0-3" ;
    ] ;
.

_:getDigitsResourceLastTwoBytes
    :method "GET" ;
    :uri _:digitsResource ;
    :headers [
        :key "Range" ;
        :value "bytes=-2" ;
    ] ;
.

_:headTextResource
    :method "HEAD" ;
    :uri _:textResource ;
.

_:headContainer
    :method "HEAD" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getMissingResource
    :method "GET" ;
    :uri [
        :base _:container ;
        :relative [
            :constant "missing-resource" ;
        ] ;
    ] ;
.

_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getStorageDescriptionAsCid
    :method "GET" ;
    :uri _:storage ;
    :headers [
        :key "Accept" ;
        :value "application/lws+cid" ;
    ] ;
.

_:createSameBytesResource
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :body "same bytes" ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:createResourceBeneathDataResource
    :method "POST" ;
    :uri [
        :base _:storageRoot ;
        :relative [
            :single [
                :variable "notAContainerLocation" ;
            ] ;
        ] ;
    ] ;
    :headers _:contentTypeTextPlain ;
    :body "should be refused" ;
.

_:getContainerWithWeightedAccept
    :method "GET" ;
    :uri _:container ;
    :headers [
        :key "Accept" ;
        :value "text/html;q=0.9, application/ld+json;q=0.5" ;
    ] ;
.

_:getContainerWithLwsProfileAccept
    :method "GET" ;
    :uri _:container ;
    :headers [
        :key "Accept" ;
        :value "application/ld+json; profile=\"https://www.w3.org/ns/lws/v1\"" ;
    ] ;
.

_:getContainerAsJsonLd
    :method "GET" ;
    :uri _:container ;
    :headers [
        :key "Accept" ;
        :value "application/ld+json" ;
    ] ;
.

_:getContainerAsJson
    :method "GET" ;
    :uri _:container ;
    :headers [
        :key "Accept" ;
        :value "application/json" ;
    ] ;
.

# URIs
_:storageRoot
    :variable "storageRoot" ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:digitsResource
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "digitsResourceLocation" ;
        ] ;
    ] ;
.

_:storage
    :base [
        :variable "baseUri" ;
    ] ;
    :relative [
        :constant "/" ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value "application/lws+json" ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value "text/plain" ;
.

# Extractors
_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:containerLocation
    :to "containerLocation" ;
    :header "Location" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

_:contentType
    :to "contentType" ;
    :header "Content-Type" ;
.

_:type
    :to "type" ;
    :path "$.type" ;
.

_:items
    :to "items" ;
    :path "$.items" ;
.

_:typeLinks
    :to "typeLinks" ;
    :link "type" ;
.

_:linksetLinks
    :to "linksetLinks" ;
    :link "linkset" ;
.

# Assertions
_:200
    :input [
        :variable "status" ;
    ] ;
    :equals "200" ;
.

_:201
    :input [
        :variable "status" ;
    ] ;
    :equals "201" ;
.

_:206
    :input [
        :variable "status" ;
    ] ;
    :equals "206" ;
.

_:404
    :input [
        :variable "status" ;
    ] ;
    :equals "404" ;
.

_:405
    :input [
        :variable "status" ;
    ] ;
    :equals "405" ;
.

_:416
    :input [
        :variable "status" ;
    ] ;
    :equals "416" ;
.

_:emptyItems
    :input [
        :variable "items" ;
    ] ;
    :equals "[]" ;
.

_:emptyBody
    :input [
        :variable "body" ;
    ] ;
    :equals "" ;
.

_:sameBytesBody
    :input [
        :variable "body" ;
    ] ;
    :regex "^same bytes$" ;
.

_:textPlainContentType
    :input [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :regex "(?i)^text/plain\\s*(;|$)" ;
.

_:lwsJsonContentType
    :input [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :regex "(?i)^application/lws\\+json\\s*(;|$)" ;
.

_:lwsCidContentType
    :input [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :regex "(?i)^application/lws\\+cid\\s*(;|$)" ;
.

_:containerType
    :input [
        :variable "type" ;
    ] ;
    :regex "^Container$|\"Container\"" ;
.

_:containerTypeLink
    :input [
        :variable "typeLinks" ;
    ] ;
    :contains "https://www.w3.org/ns/lws#Container" ;
.

_:dataResourceTypeLink
    :input [
        :variable "typeLinks" ;
    ] ;
    :contains "https://www.w3.org/ns/lws#DataResource" ;
.

_:itemsArray
    :input [
        :variable "items" ;
    ] ;
    :regex "^\\[" ;
.

_:jsonLdContentType
    :input [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :regex "(?i)^application/ld\\+json\\s*(;|$)" ;
.

_:linksetLink
    :input [
        :count [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :greaterThan 0 ;
.
