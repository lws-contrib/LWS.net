_:containerResponseVariesByAccept
    :testName "Container response varies by Accept" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerVary
    ) ;
    :assert [
        :that [
            :single [
                :variable "vary" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)(^|[\\s,])accept($|[\\s,])" ] ;
    ] ;
.

_:dataResourceAdvertisesByteRanges
    :testName "Data resource advertises byte ranges" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceAcceptRanges
    ) ;
    :assert [
        :that [
            :single [
                :variable "acceptRanges" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)\\bbytes\\b" ] ;
    ] ;
.

_:suffixByteRangeReturnsLastBytes
    :testName "Suffix byte range returns last bytes" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceLastTwoBytesBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :matches [ :constant "^89$" ] ;
