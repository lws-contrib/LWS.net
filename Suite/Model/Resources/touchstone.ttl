    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers [
            :key "Range" ;
            :value "bytes=100-200" ;
        ] ;
    ] ;
    :extractors (
        _:status
    ) ;
.

_:createNestedContainer
    :stepName "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        _:containerLocation
        _:status
        _:typeLinks
    ) ;
.

_:getContainerItems
