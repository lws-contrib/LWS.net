# Steps
_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :variable "baseUri" ;
            ] ;
            :relative [
                :constant "/" ;
            ] ;
        ] ;
    ] ;
    :extractors (
        [
            :to "storageRoot" ;
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extractors (
        _:containerLocation
    ) ;
.

_:getContainerStatus
    :stepName "Get container status" ;
    :request _:getContainer ;
    :extractors (
        _:status
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extractors (
        [
            :to "textResourceLocation" ;
            :header "Location" ;
        ]
        _:status
    ) ;
.

_:getTextResourceBody
    :stepName "Get text resource body" ;
    :request _:getTextResource ;
    :extractors (
        _:body
    ) ;
.

_:createDigitsResource
    :stepName "Create digits resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "0123456789" ;
    ] ;
    :extractors (
        [
            :to "digitsResourceLocation" ;
            :header "Location" ;
        ]
    ) ;
.

