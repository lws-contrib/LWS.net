        _:createDataResourceReturns201 ,
        _:createDataResourceReturnsLocation ,
        _:secondOfTwoIdenticalCreatesReturns201 ,
        _:containerGetLinksLinkset ,
        _:dataResourceGetLinksLinkset ,
        _:containerHeadLinksLinkset ,
        _:dataResourceHeadLinksLinkset ,
        _:createWithForgedLinksetLinkLinksLinkset ,
        _:resourceCreatedWithForgedLinksetLinkGetLinksLinkset ,
        _:containerHeadLinksUp ;
] .

# Tests

_:containerGetReturns200
    :testName "Container GET returns 200" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStatus
    ) ;
    :assert _:200 ;
.

_:createdDataResourceReturnsPostedBody
    :testName "Created data resource returns posted body" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceBody
    ) ;
    :assert [
        :input [
            :variable "body" ;
        ] ;
        :equals "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
.

_:rangeBeyondEndReturns416
    :testName "Range beyond end returns 416" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceBeyondEndStatus
    ) ;
    :assert _:416 ;
.

_:newNestedContainerHasNoItems
    :testName "New nested container has no items" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getContainerItems
    ) ;
    :assert _:emptyItems ;
.

_:byteRangeReturns206
    :testName "Byte range returns 206" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createDigitsResource
        _:getDigitsResourceFirstFourBytesStatus
    ) ;
    :assert _:206 ;
.

_:newContainerHasNoItems
    :testName "New container has no items" ;
    :steps (
        _:discoverStorageRoot
