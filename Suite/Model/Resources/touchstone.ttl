# Steps
_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request [
        :method "GET" ;
        :uri [
            :base [
                :variable "baseUri" ;
            ] ;
            :relative [
                :constant "/" ;
            ] ;
        ] ;
    ] ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
    ) ;
.

_:getContainerStatus
    :stepName "Get container status" ;
    :request _:getContainer ;
    :extract (
        _:status
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "textResourceLocation" ;
        ]
        _:status
        _:linksetLinks
    ) ;
.

_:getTextResourceBody
    :stepName "Get text resource body" ;
    :request _:getTextResource ;
    :extract (
        _:body
    ) ;
.

_:createDigitsResource
    :stepName "Create digits resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "0123456789" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "digitsResourceLocation" ;
        ]
    ) ;
.

_:getDigitsResourceBeyondEndStatus
    :stepName "Get digits resource beyond end status" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
        :headers [
            :key "Range" ;
            :value [ :constant "bytes=100-200" ] ;
        ] ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:createNestedContainer
    :stepName "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
        _:status
        _:typeLinks
    ) ;
.

_:getContainerItems
    :stepName "Get container items" ;
    :request _:getContainer ;
    :extract (
        _:items
    ) ;
.

_:getContainerId
    :stepName "Get container id" ;
    :request _:getContainer ;
    :extract (
        _:id
    ) ;
.

_:getDigitsResourceFirstFourBytesStatus
    :stepName "Get digits resource first four bytes status" ;
    :request _:getDigitsResourceFirstFourBytes ;
    :extract (
        _:status
    ) ;
.

_:getDigitsResourceLastTwoBytesStatus
    :stepName "Get digits resource last two bytes status" ;
    :request _:getDigitsResourceLastTwoBytes ;
    :extract (
        _:status
    ) ;
.

_:headTextResourceBody
    :stepName "Head text resource body" ;
    :request _:headTextResource ;
    :extract (
        _:body
    ) ;
.

_:headContainerBody
    :stepName "Head container body" ;
    :request _:headContainer ;
    :extract (
        _:body
    ) ;
.

_:createResourceWithForgedLinkset
    :stepName "Create resource with forged linkset" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers
            _:contentTypeTextPlain ,
            [
                :key "Link" ;
                :value [ :constant "<https://linkset.invalid/forged>; rel=\"linkset\"" ] ;
            ] ;
        :body [ :constant "metadata override attempt" ] ;
    ] ;
    :extract (
        _:status
        _:linksetLinks
        [
            :header "Location" ;
            :to "forgedLinksetLocation" ;
        ]
    ) ;
.

_:getContainerWithWeightedAcceptStatus
    :stepName "Get container with weighted Accept status" ;
    :request _:getContainerWithWeightedAccept ;
    :extract (
        _:status
    ) ;
.

_:getContainerVary
    :stepName "Get container Vary" ;
    :request _:getContainer ;
    :extract (
        [
            :header "Vary" ;
            :to "vary" ;
        ]
    ) ;
.

_:getDigitsResourceAcceptRanges
    :stepName "Get digits resource Accept-Ranges" ;
    :request [
        :method "GET" ;
        :uri _:digitsResource ;
    ] ;
    :extract (
        [
            :header "Accept-Ranges" ;
            :to "acceptRanges" ;
        ]
    ) ;
.

_:getDigitsResourceLastTwoBytesBody
    :stepName "Get digits resource last two bytes body" ;
    :request _:getDigitsResourceLastTwoBytes ;
    :extract (
        _:body
    ) ;
.

_:getDigitsResourceFirstFourBytesContentRange
    :stepName "Get digits resource first four bytes Content-Range" ;
    :request _:getDigitsResourceFirstFourBytes ;
    :extract (
        [
            :header "Content-Range" ;
            :to "contentRange" ;
        ]
    ) ;
.

_:getDigitsResourceFirstFourBytesBody
    :stepName "Get digits resource first four bytes body" ;
    :request _:getDigitsResourceFirstFourBytes ;
    :extract (
        _:body
    ) ;
.

_:createResourceInMissingContainer
    :stepName "Create resource in missing container" ;
    :request [
        :method "POST" ;
        :uri [
            :base _:container ;
            :relative [
                :constant "missing-container/" ;
            ] ;
        ] ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "lost letter" ] ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:createFirstSameBytesResource
    :stepName "Create first same-bytes resource" ;
    :request _:createSameBytesResource ;
    :extract (
        [
            :header "Location" ;
            :to "firstSameBytesLocation" ;
        ]
    ) ;
.

_:createSecondSameBytesResource
    :stepName "Create second same-bytes resource" ;
    :request _:createSameBytesResource ;
    :extract (
        [
            :header "Location" ;
            :to "secondSameBytesLocation" ;
        ]
        _:status
    ) ;
.

_:getFirstSameBytesResourceBody
    :stepName "Get first same-bytes resource body" ;
    :request [
        :method "GET" ;
        :uri [
            :base _:storageRoot ;
            :relative [
                :single [
                    :variable "firstSameBytesLocation" ;
                ] ;
            ] ;
        ] ;
    ] ;
    :extract (
        _:body
    ) ;
.

_:getSecondSameBytesResourceBody
    :stepName "Get second same-bytes resource body" ;
    :request [
        :method "GET" ;
        :uri [
            :base _:storageRoot ;
            :relative [
                :single [
                    :variable "secondSameBytesLocation" ;
                ] ;
            ] ;
        ] ;
    ] ;
    :extract (
        _:body
    ) ;
.

_:createDataResource
    :stepName "Create data resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "not a container" ] ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "notAContainerLocation" ;
        ]
    ) ;
.

