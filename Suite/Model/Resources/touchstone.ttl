# Requests
_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:conditionalGetContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
    :headers [
        :key "If-None-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
.

_:getLinkset
    :method "GET" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

_:patchLinksetStaleIfMatch
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers [
        :key "If-Match" ;
        :value [ :constant "\"touchstone-stale-etag\"" ] ;
    ] ;
    :body [ :constant "[{\"op\":\"add\",\"path\":\"/linkset/0/license\",\"value\":[{\"href\":\"https://creativecommons.org/licenses/by/4.0/\"}]}]" ] ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:conditionalGetTextResource
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-None-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
.

_:conditionalGetTextResourceIfModifiedSince
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-Modified-Since" ;
        :value [
            :single [
                :variable "lastModified" ;
            ] ;
        ] ;
    ] ;
.

_:conditionalGetTextResourceIfModifiedSinceEpoch
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-Modified-Since" ;
        :value [ :constant "Thu, 01 Jan 1970 00:00:00 GMT" ] ;
    ] ;
.

_:conditionalGetTextResourceIfUnmodifiedSince
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-Unmodified-Since" ;
        :value [
            :single [
                :variable "lastModified" ;
            ] ;
        ] ;
    ] ;
.

_:conditionalGetTextResourceIfUnmodifiedSinceEpoch
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-Unmodified-Since" ;
        :value [ :constant "Thu, 01 Jan 1970 00:00:00 GMT" ] ;
    ] ;
.

_:conditionalPutTextResourceIfMatch
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
    :body [ :constant "second content" ] ;
.

_:conditionalPutTextResourceStaleIfMatch
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
    :body [ :constant "third content, must not land" ] ;
.

_:conditionalGetTextResourceNeverMatching
    :method "GET" ;
    :uri _:textResource ;
    :headers [
        :key "If-None-Match" ;
        :value [ :constant "\"touchstone-never-a-real-etag\"" ] ;
    ] ;
.

_:conditionalPutTextResourceIfMatchChangedContent
    :method "PUT" ;
    :uri _:textResource ;
    :headers _:contentTypeTextPlain ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
    :body [ :constant "changed content" ] ;
.

_:conditionalDeleteTextResourceStaleIfMatch
    :method "DELETE" ;
    :uri _:textResource ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
.

_:getDigitsResourceFirstFourBytes
    :method "GET" ;
    :uri _:digitsResource ;
    :headers [
        :key "Range" ;
        :value [ :constant "bytes=0-3" ] ;
    ] ;
.

_:getDigitsResourceLastTwoBytes
    :method "GET" ;
    :uri _:digitsResource ;
    :headers [
        :key "Range" ;
        :value [ :constant "bytes=-2" ] ;
    ] ;
.

_:headTextResource
    :method "HEAD" ;
    :uri _:textResource ;
.

_:headContainer
    :method "HEAD" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getMissingResource
    :method "GET" ;
    :uri [
        :base _:container ;
        :relative [
            :constant "missing-resource" ;
        ] ;
    ] ;
.

_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getStorageDescriptionAsCid
    :method "GET" ;
    :uri _:storage ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/lws+cid" ] ;
    ] ;
.

_:createSameBytesResource
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :body [ :constant "same bytes" ] ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:createResourceBeneathDataResource
    :method "POST" ;
    :uri [
        :base _:storageRoot ;
        :relative [
            :single [
                :variable "notAContainerLocation" ;
            ] ;
        ] ;
    ] ;
    :headers _:contentTypeTextPlain ;
    :body [ :constant "should be refused" ] ;
.

_:getContainerWithWeightedAccept
    :method "GET" ;
    :uri _:container ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/x-touchstone-unservable;q=0.9, application/lws+json;q=0.5" ] ;
    ] ;
.

_:headLeaf
    :method "HEAD" ;
    :uri _:leaf ;
.

_:getInnerContainer
    :method "GET" ;
    :uri _:inner ;
    :headers _:acceptLwsJson ;
.

_:getOuterContainer
    :method "GET" ;
    :uri _:outer ;
    :headers _:acceptLwsJson ;
.

_:deleteInnerContainer
    :method "DELETE" ;
    :uri _:inner ;
    :headers [
        :key "If-Match" ;
        :value [
            :single [
                :variable "etag" ;
            ] ;
        ] ;
    ] ;
.

_:getLeaf
    :method "GET" ;
    :uri _:leaf ;
.

_:getAuthorizationServerMetadata
    :method "GET" ;
    :uri _:authorizationServerMetadata ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/json" ] ;
    ] ;
.

_:exchangeTokenWithoutSubjectToken
    :method "POST" ;
    :uri _:tokenEndpoint ;
    :body [
        :form (
            [
                :formKey "grant_type" ;
                :formValue [ :constant "urn:ietf:params:oauth:grant-type:token-exchange" ] ;
            ]
            [
                :formKey "resource" ;
                :formValue _:storage ;
            ]
            [
                :formKey "subject_token_type" ;
                :formValue [ :constant "urn:ietf:params:oauth:token-type:jwt" ] ;
            ]
        ) ;
    ] ;
.

# URIs
_:storageRoot
    :single [
        :variable "storageRoot" ;
    ] ;
.

_:linkset
    :single [
        :variable "linksetLinks" ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:digitsResource
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "digitsResourceLocation" ;
        ] ;
    ] ;
.

_:storage
    :base [
        :variable "baseUri" ;
    ] ;
    :relative [
        :constant "/" ;
    ] ;
.

_:outer
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "outerLocation" ;
        ] ;
    ] ;
.

_:inner
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "innerLocation" ;
        ] ;
    ] ;
.

_:leaf
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "leafLocation" ;
        ] ;
    ] ;
.

_:authorizationServer
    :single [
        :variable "authorizationServer" ;
    ] ;
.

_:authorizationServerMetadata
    :base _:authorizationServer ;
    :relative [
        :constant "/.well-known/lws-configuration" ;
    ] ;
.

_:tokenEndpoint
    :base _:authorizationServer ;
    :relative [
        :constant "/token" ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:acceptLinksetJson
    :key "Accept" ;
    :value [ :constant "application/linkset+json" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:contentTypeJsonPatch
    :key "Content-Type" ;
    :value [ :constant "application/json-patch+json" ] ;
.

# Extractors
_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:type
    :path "$.type" ;
    :to "type" ;
.

_:items
    :path "$.items" ;
    :to "items" ;
.

_:id
    :path "$.id" ;
    :to "id" ;
.

_:typeLinks
    :link "type" ;
    :to "typeLinks" ;
.

_:storageLinks
    :link "https://www.w3.org/ns/lws#storage" ;
    :to "storageLinks" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

_:linksetMembers
    :path "$.linkset" ;
    :to "linksetMembers" ;
.

_:itemIds
    :path "$.items[*].id" ;
    :to "itemIds" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.

# Assertions
_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:201
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "201" ] ;
.

_:206
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "206" ] ;
.

_:304
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "304" ] ;
.

_:412
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "412" ] ;
.

_:400
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "400" ] ;
.

_:404
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "404" ] ;
.

_:405
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "405" ] ;
.

_:409
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "409" ] ;
.

_:416
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "416" ] ;
.

_:emptyItems
    :that [
        :single [
            :variable "items" ;
        ] ;
    ] ;
    :equals [ :constant "[]" ] ;
.

_:emptyBody
    :that [
        :variable "body" ;
    ] ;
    :equals [ :constant "" ] ;
.

_:sameBytesBody
    :that [
        :variable "body" ;
    ] ;
    :matches [ :constant "^same bytes$" ] ;
.

_:textPlainContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^text/plain\\s*(;|$)" ] ;
.

_:lwsJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+json\\s*(;|$)" ] ;
.

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+cid\\s*(;|$)" ] ;
.

_:linksetJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/linkset\\+json\\s*(;|$)" ] ;
.

_:jsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/json\\s*(;|$)" ] ;
.

_:linksetArray
    :that [
        :single [
            :variable "linksetMembers" ;
        ] ;
    ] ;
    :matches [ :constant "^\\[" ] ;
.

_:containerType
    :that [
        :single [
            :variable "type" ;
        ] ;
    ] ;
    :matches [ :constant "^Container$|\"Container\"" ] ;
.

_:containerTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains [ :constant "https://www.w3.org/ns/lws#Container" ] ;
.

_:dataResourceTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains [ :constant "https://www.w3.org/ns/lws#DataResource" ] ;
.

_:itemsArray
    :that [
        :single [
            :variable "items" ;
        ] ;
    ] ;
    :matches [ :constant "^\\[" ] ;
.

_:linksetLink
    :that [
        :count [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :greaterThan [ :constant 0 ] ;
.
