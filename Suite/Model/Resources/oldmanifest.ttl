@prefix : <http://example.com/> .

[
    :manifestName "LWS Protocol 1.0 Test Suite" ;
    :test
        _:storageContentTypeIsLwsCid ,
        _:storageRootIsContainer ,
        _:storageRootIsContainerStatus ,
        _:storageRootIsContainerTypeLink ,
        _:discoveryStorageDescriptionStatus ,
        _:discoveryStorageDescriptionContentType ,
        _:discoveryGetLinksStorageDescriptionStatus ,
        _:getContainerReturns200 ,
        _:getContainerReturnsLwsJsonMediaType ,
        _:getContainerLinksContainerType ,
        _:readDataResourceReturns200 ,
        _:readDataResourceReturnsTextPlain ,
        _:readDataResourceLinksDataResourceType ,
        _:readDataResourceReturnsBody ,
        _:getLinksetReturns200 ,
        _:getLinksetReturnsLinksetJsonMediaType ,
        _:containerWithMemberReturns200 ,
        _:containerWithMemberReturnsLwsJsonMediaType ;
] .

# Tests

_:storageContentTypeIsLwsCid
    :testName "Storage content-type is LWS CID" ;
    :steps (
        _:getStorageContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageRootIsContainer
    :testName "Storage root is container" ;
    :steps (
        _:getStorageFirst
        _:getStorageTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:storageRootIsContainerStatus
    :testName "storage-root-is-container-status" ;
    :steps (
        _:getStorageStatus
    ) ;
    :assert _:200 ;
.

_:storageRootIsContainerTypeLink
    :testName "storage-root-is-container-type-link" ;
    :steps (
        _:getStorageTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:discoveryStorageDescriptionStatus
    :testName "discovery-storage-description-status" ;
    :steps (
        _:getStorageAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:discoveryStorageDescriptionContentType
    :testName "discovery-storage-description-content-type" ;
    :steps (
        _:getStorageAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

_:discoveryGetLinksStorageDescriptionStatus
    :testName "discovery-get-links-storageDescription-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStatus
    ) ;
    :assert _:200 ;
.

_:getContainerReturns200
    :testName "getContainer-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:getContainerReturnsLwsJsonMediaType
    :testName "getContainer-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

_:getContainerLinksContainerType
    :testName "getContainer-type-link" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerAsLwsJsonTypeLinks
    ) ;
    :assert _:containerTypeLink ;
.

_:readDataResourceReturns200
    :testName "readDataResource-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListStatus
    ) ;
    :assert _:200 ;
.

_:readDataResourceReturnsTextPlain
    :testName "readDataResource-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListContentType
    ) ;
    :assert _:textPlainContentType ;
.

_:readDataResourceLinksDataResourceType
    :testName "readDataResource-type-link" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListTypeLinks
    ) ;
    :assert _:dataResourceTypeLink ;
.

_:readDataResourceReturnsBody
    :testName "readDataResource-body" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getShoppingListBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :equals "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
.

_:getLinksetReturns200
    :testName "getLinkset-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
        _:getLinksetStatus
    ) ;
    :assert _:200 ;
.

_:getLinksetReturnsLinksetJsonMediaType
    :testName "getLinkset-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
        _:getLinksetContentType
    ) ;
    :assert [
        :that [
            :single [
                :variable "contentType" ;
            ] ;
        ] ;
        :matches "(?i)^application/linkset\\+json\\s*(;|$)" ;
    ] ;
.

_:containerWithMemberReturns200
    :testName "getContainer-containmentIntegrity-status" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getContainerAsLwsJsonStatus
    ) ;
    :assert _:200 ;
.

_:containerWithMemberReturnsLwsJsonMediaType
    :testName "getContainer-containmentIntegrity-content-type" ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createShoppingList
        _:getContainerAsLwsJsonContentType
    ) ;
    :assert _:lwsJsonContentType ;
.

# Steps

_:getStorageFirst
    :stepName "Get storage first" ;
    :request _:getStorage ;
    :extract () ;
.

_:getStorageContentType
    :stepName "Get storage Content-Type" ;
    :request _:getStorage ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageTypeLinks
    :stepName "Get storage type links" ;
    :request _:getStorage ;
    :extract (
        _:typeLinks
    ) ;
.

_:getStorageStatus
    :stepName "Get storage status" ;
    :request _:getStorage ;
    :extract (
        _:status
    ) ;
.

_:getStorageAsLwsJsonStatus
    :stepName "Get storage as LWS JSON status" ;
    :request _:getStorageAsLwsJson ;
    :extract (
        _:status
    ) ;
.

_:getStorageAsLwsJsonContentType
    :stepName "Get storage as LWS JSON Content-Type" ;
    :request _:getStorageAsLwsJson ;
    :extract (
        _:contentType
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorage ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "containerLocation" ;
        ]
    ) ;
.

_:getContainerStatus
    :stepName "Get container status" ;
    :request _:getContainer ;
    :extract (
        _:status
    ) ;
.

_:getContainerAsLwsJsonStatus
    :stepName "Get container as LWS JSON status" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:status
    ) ;
.

_:getContainerAsLwsJsonContentType
    :stepName "Get container as LWS JSON Content-Type" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:contentType
    ) ;
.

_:getContainerAsLwsJsonTypeLinks
    :stepName "Get container as LWS JSON type links" ;
    :request _:getContainerAsLwsJson ;
    :extract (
        _:typeLinks
    ) ;
.

_:createShoppingList
    :stepName "Create shopping list" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extract (
        [
            :header "Location" ;
            :to "shoppingListLocation" ;
        ]
    ) ;
.

_:getShoppingListStatus
    :stepName "Get shopping list status" ;
    :request _:getShoppingList ;
    :extract (
        _:status
    ) ;
.

_:getShoppingListContentType
    :stepName "Get shopping list Content-Type" ;
    :request _:getShoppingList ;
    :extract (
        _:contentType
    ) ;
.

_:getShoppingListTypeLinks
    :stepName "Get shopping list type links" ;
    :request _:getShoppingList ;
    :extract (
        _:typeLinks
    ) ;
.

_:getShoppingListBody
    :stepName "Get shopping list body" ;
    :request _:getShoppingList ;
    :extract (
        _:body
    ) ;
.

_:getContainerLinksetLinks
    :stepName "Get container linkset links" ;
    :request _:getContainer ;
    :extract (
        [
            :link "linkset" ;
            :to "linksetLinks" ;
        ]
    ) ;
.

_:getLinksetStatus
    :stepName "Get linkset status" ;
    :request _:getLinkset ;
    :extract (
        _:status
    ) ;
.

_:getLinksetContentType
    :stepName "Get linkset Content-Type" ;
    :request _:getLinkset ;
    :extract (
        _:contentType
    ) ;
.

# Requests

_:getStorage
    :method "GET" ;
    :uri _:storage ;
.

_:getStorageAsLwsJson
    :method "GET" ;
    :uri _:storage ;
    :headers _:acceptLwsJson ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
.

_:getContainerAsLwsJson
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getShoppingList
    :method "GET" ;
    :uri _:shoppingList ;
.

_:getLinkset
    :method "GET" ;
    :uri [
        :single [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :headers [
        :key "Accept" ;
        :value "application/linkset+json" ;
    ] ;
.

# URIs

_:storage
    :base [
        :variable "baseUri" ;
    ] ;
    :relative [
        :constant "/" ;
    ] ;
.

_:storageRoot
    :variable "storageRoot" ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:shoppingList
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "shoppingListLocation" ;
        ] ;
    ] ;
.

# Headers

_:acceptLwsJson
    :key "Accept" ;
    :value "application/lws+json" ;
.

_:linkTypeContainer
    :key "Link" ;
    :value "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value "text/plain" ;
.

# Extractors

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:typeLinks
    :link "type" ;
    :to "typeLinks" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

# Assertions

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches "(?i)^application/lws\\+cid\\s*(;|$)" ;
.

_:containerTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains "https://www.w3.org/ns/lws#Container" ;
.

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals "200" ;
.

_:lwsJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches "(?i)^application/lws\\+json\\s*(;|$)" ;
.

_:textPlainContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches "(?i)^text/plain\\s*(;|$)" ;
.

_:dataResourceTypeLink
    :that [
        :variable "typeLinks" ;
    ] ;
    :contains "https://www.w3.org/ns/lws#DataResource" ;
.
