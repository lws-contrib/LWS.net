@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "From specification: Linked Web Storage Protocol 1.0" ;
    :test
        _:storageDescriptionHasIdProperty ,
        _:storageDescriptionIdIsCanonicalStorageUri ,
        _:storageDescriptionHasTypeProperty ,
        _:storageDescriptionTypeIsOrContainsStorage ,
        _:storageDescriptionHasServiceProperty ,
        _:storageDescriptionServicesContainStorageRoot ,
        _:storageRootServiceEndpointIsUri ,
        _:storageDescriptionServiceEntriesHaveTypeProperty ,
        _:storageDescriptionServiceEntriesHaveServiceEndpointProperty ,
        _:getDataResourceLinksStorage ,
        _:getContainerLinksStorage ,
        _:headDataResourceLinksStorage ,
        _:headContainerLinksStorage ,
        _:getStorageDescriptionLinksStorage ,
        _:getStorageUriReturns200 ,
        _:getStorageUriReturnsLwsCid ,
        _:storageDescriptionSerializableAsLwsCid ,
        _:storageRootServiceEndpointIsStorageRootContainer ,
        _:storageDescriptionContextStartsWithCidAndLws ,
        _:headStorageDescriptionLinksStorage ,
        _:getStorageRootContainerLinksStorage ,
        _:headStorageRootContainerLinksStorage ,
        _:getNonRootDataResourceLinksParentContainerAsUp ,
        _:getNonRootContainerLinksParentContainerAsUp ,
        _:headNonRootDataResourceLinksParentContainerAsUp ,
        _:headNonRootContainerLinksParentContainerAsUp ,
        _:createdResourceIsAddedToContainerItems ,
        _:deletedResourceIsRemovedFromParentContainerItems ,
        _:containerRepresentationIncludesAllContainedResources ,
        _:deletingNonEmptyContainerReturns409 ,
        _:createdContainerIsAddedToParentContainerItems ,
        _:getNestedContainerLinksParentContainerAsUp ,
        _:containerRepresentationHasIdProperty ,
        _:containerRepresentationIdIsUriOfContainer ,
        _:containerRepresentationTypeIsContainer ,
        _:containerRepresentationTotalItemsIsInteger ,
        _:containerRepresentationItemsIsArrayOfContainedResourceDescriptions ,
        _:emptyContainerItemsIsEmptyArray ,
        _:containedResourceDescriptionHasIdProperty ,
        _:containedResourceDescriptionIdIsUriOfContainedResource ,
        _:containedDataResourceDescriptionTypeEqualsOrContainsDataResource ,
        _:containedContainerDescriptionTypeEqualsOrContainsContainer ,
        _:containedDataResourceDescriptionFormatIsMediaTypeOfDataResource ,
        _:metadataLinksAreAvailableAsStandaloneResource ,
        _:containerMetadataLinksAreAvailableAsStandaloneResource ,
        _:linksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:containerLinksetIsDiscoverableViaLinkHeaderWithRelLinkset ,
        _:linksetResourceIsAvailableAsApplicationLinksetJson ,
        _:linksetResourceBodyIsRfc9264Linkset ,
        _:allowHeaderOfLinksetAdvertisesGet ,
        _:allowHeaderOfLinksetAdvertisesPatch ,
        _:acceptPatchHeaderOfLinksetAdvertisesJsonPatch ,
        _:linksetGetResponseIncludesEtagHeader ,
        _:linksetHeadResponseIncludesEtagHeader ,
        _:linksetResourceSupportsPatchUsingApplicationJsonPatchJson ,
        _:serverPreservesLinksClientIsNotPermittedToModifyWhenApplyingPatch ,
        _:deletingResourceRemovesItsAssociatedLinksetResource ,
        _:serverManagedMetadataIsGeneratedAutomaticallyUponCreation ,
        _:serverManagedUpLinkIsNotOverriddenByClientProvidedLink ,
        _:serverManagedLinksetLinkIsNotOverriddenByClientProvidedLink ,
        _:successfulCreationReturns201StatusCode ,
        _:successfulCreationReturnsNewUriInLocationHeader ,
        _:createdResourceCanBeRetrievedUsingGetOnItsNewUri ,
        _:createResponseIncludesLinkHeaderWithRelUp ,
        _:createResponseLinkHeaderWithRelUpTargetsParentContainer ,
        _:createResponseIncludesLinkHeaderWithRelLinkset ,
        _:dataResourceIsCreatedWithContentFromRequestBody ,
        _:postWithLinkHeaderWithRelTypeContainerCreatesContainer ,
        _:containerCreationResponseLinkRelUpTargetsParentContainer ,
        _:containerCreationResponseIncludesLinkHeaderWithRelLinkset ,
        _:linksetResourceIsCreatedAndPopulatedBeforeReturningSuccess ;
] .

# Tests

_:storageDescriptionHasIdProperty
    :testName "Storage description has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :single [
                :variable "id" ;
            ] ;
        ] ;
        :matches [ :constant "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    ] ;
.

_:storageDescriptionIdIsCanonicalStorageUri
    :testName "Storage description id is canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :base _:storage ;
            :relative [
                :single [
                    :variable "id" ;
                ] ;
            ] ;
        ] ;
        :equals _:storage ;
    ] ;
.

_:storageDescriptionHasTypeProperty
    :testName "Storage description has type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^(?!\\[\\s*\\]$).+" ] ;
    ] ;
.

_:storageDescriptionTypeIsOrContainsStorage
    :testName "Storage description type equals or contains Storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Storage$|\"Storage\"" ] ;
    ] ;
.

_:storageDescriptionHasServiceProperty
    :testName "Storage description has service property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionServices
    ) ;
    :assert [
        :that [
            :count [
                :variable "services" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServicesContainStorageRoot
    :testName "Storage description services contain StorageRoot" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :count [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageRootServiceEndpointIsUri
    :testName "StorageRoot serviceEndpoint is URI" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :single [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :matches [ :constant "^https?://.+" ] ;
    ] ;
.

_:storageDescriptionServiceEntriesHaveTypeProperty
    :testName "Storage description service entries have type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getServicesWhenAllHaveType
    ) ;
    :assert [
        :that [
            :count [
                :variable "servicesAllHavingType" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServiceEntriesHaveServiceEndpointProperty
    :testName "Storage description service entries have serviceEndpoint property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getServicesWhenAllHaveServiceEndpoint
    ) ;
    :assert [
        :that [
            :count [
                :variable "servicesAllHavingServiceEndpoint" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:getDataResourceLinksStorage
    :testName "GET data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getContainerLinksStorage
    :testName "GET container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

