                :single [
                    :variable "containerId" ;
                ] ;
            ] ;
        ] ;
        :equals _:container ;
    ] ;
.

_:containerRepresentationTypeIsContainer
    :testName "Container representation type is Container" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerType
    ) ;
    :assert [
