_:getNonRootDataResourceLinksParentContainerAsUp
    :testName "GET non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:getNonRootContainerLinksParentContainerAsUp
    :testName "GET non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:headNonRootDataResourceLinksParentContainerAsUp
    :testName "HEAD non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
