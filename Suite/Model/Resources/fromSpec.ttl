@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "From specification: Linked Web Storage Protocol 1.0" ;
    :test
        _:storageDescriptionHasIdProperty ,
        _:storageDescriptionIdIsCanonicalStorageUri ,
        _:storageDescriptionHasTypeProperty ,
        _:storageDescriptionTypeIsOrContainsStorage ,
        _:storageDescriptionHasServiceProperty ,
        _:storageDescriptionServicesContainStorageRoot ,
        _:storageRootServiceEndpointIsUri ,
        _:getDataResourceLinksStorage ,
        _:getContainerLinksStorage ,
        _:headDataResourceLinksStorage ,
        _:headContainerLinksStorage ,
        _:getStorageDescriptionLinksStorage ,
        _:getStorageUriReturns200 ,
        _:getStorageUriReturnsLwsCid ,
        _:storageDescriptionSerializableAsLwsCid ,
        _:storageRootServiceEndpointIsStorageRootContainer ,
        _:storageDescriptionContextStartsWithCidAndLws ,
        _:headStorageDescriptionLinksStorage ,
        _:getStorageRootContainerLinksStorage ,
        _:headStorageRootContainerLinksStorage ,
        _:getNonRootDataResourceLinksParentContainerAsUp ,
        _:getNonRootContainerLinksParentContainerAsUp ,
        _:headNonRootDataResourceLinksParentContainerAsUp ,
        _:headNonRootContainerLinksParentContainerAsUp ,
        _:createdResourceIsAddedToContainerItems ,
        _:deletedResourceIsRemovedFromParentContainerItems ,
        _:containerRepresentationIncludesAllContainedResources ,
        _:deletingNonEmptyContainerReturns409 ,
        _:createdContainerIsAddedToParentContainerItems ,
        _:getNestedContainerLinksParentContainerAsUp ,
        _:containerRepresentationHasIdProperty ,
        _:containerRepresentationIdIsUriOfContainer ,
        _:containerRepresentationTypeIsContainer ;
] .

# Tests

_:storageDescriptionHasIdProperty
    :testName "Storage description has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :single [
                :variable "id" ;
            ] ;
        ] ;
        :matches [ :constant "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    ] ;
.

_:storageDescriptionIdIsCanonicalStorageUri
    :testName "Storage description id is canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :base _:storage ;
            :relative [
                :single [
                    :variable "id" ;
                ] ;
            ] ;
        ] ;
        :equals _:storage ;
    ] ;
.

_:storageDescriptionHasTypeProperty
    :testName "Storage description has type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^(?!\\[\\s*\\]$).+" ] ;
    ] ;
.

_:storageDescriptionTypeIsOrContainsStorage
    :testName "Storage description type equals or contains Storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Storage$|\"Storage\"" ] ;
    ] ;
.

_:storageDescriptionHasServiceProperty
    :testName "Storage description has service property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionServices
    ) ;
    :assert [
        :that [
            :count [
                :variable "services" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServicesContainStorageRoot
    :testName "Storage description services contain StorageRoot" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :count [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageRootServiceEndpointIsUri
    :testName "StorageRoot serviceEndpoint is URI" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :single [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :matches [ :constant "^https?://.+" ] ;
    ] ;
.

_:getDataResourceLinksStorage
    :testName "GET data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getContainerLinksStorage
    :testName "GET container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headDataResourceLinksStorage
    :testName "HEAD data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headContainerLinksStorage
    :testName "HEAD container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:headContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageDescriptionLinksStorage
    :testName "GET storage description links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageUriReturns200
    :testName "GET storage URI returns 200" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionStatus
    ) ;
    :assert _:200 ;
.

_:getStorageUriReturnsLwsCid
    :testName "GET storage URI returns application/lws+cid" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageDescriptionSerializableAsLwsCid
    :testName "Storage description serializable as application/lws+cid" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-representation"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionAsCidContentType
    ) ;
    :assert _:lwsCidContentType ;
.

_:storageRootServiceEndpointIsStorageRootContainer
    :testName "StorageRoot serviceEndpoint is storage root container" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:getStorageRootType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Container$|\"Container\"" ] ;
    ] ;
.

_:storageDescriptionContextStartsWithCidAndLws
    :testName "Storage description @context starts with CID and LWS URIs" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-representation"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionAsCidContext
    ) ;
    :assert [
        :that [
            :single [
                :variable "context" ;
            ] ;
        ] ;
        :matches [ :constant "^\\[\\s*\"https://www\\.w3\\.org/ns/cid/v1\"\\s*,\\s*\"https://www\\.w3\\.org/ns/lws/v1\"" ] ;
    ] ;
.

_:headStorageDescriptionLinksStorage
    :testName "HEAD storage description links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:headStorageDescriptionStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getStorageRootContainerLinksStorage
    :testName "GET storage root container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:getStorageRootStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:headStorageRootContainerLinksStorage
    :testName "HEAD storage root container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:headStorageRootStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getNonRootDataResourceLinksParentContainerAsUp
    :testName "GET non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:getNonRootContainerLinksParentContainerAsUp
    :testName "GET non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:headNonRootDataResourceLinksParentContainerAsUp
    :testName "HEAD non-root data resource links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:headTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:headNonRootContainerLinksParentContainerAsUp
    :testName "HEAD non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:headContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:createdResourceIsAddedToContainerItems
    :testName "Created resource is added to container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:textResource ;
    ] ;
.

_:deletedResourceIsRemovedFromParentContainerItems
    :testName "Deleted resource is removed from parent container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createSecondTextResource
        _:deleteTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:secondTextResource ;
    ] ;
.

_:containerRepresentationIncludesAllContainedResources
    :testName "Container representation includes identifiers of all contained resources" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-membership-and-authorization"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:createSecondTextResource
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :count [
                :variable "itemIds" ;
            ] ;
        ] ;
        :equals [ :constant 2 ] ;
    ] ;
.

_:deletingNonEmptyContainerReturns409
    :testName "Deleting non-empty container returns 409" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#delete-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:deleteContainer
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :equals [ :constant "409" ] ;
    ] ;
.

_:createdContainerIsAddedToParentContainerItems
    :testName "Created container is added to parent container items" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment-integrity"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getContainerItemIds
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "itemIds" ;
                ] ;
            ] ;
        ] ;
        :equals _:nestedContainer ;
    ] ;
.

_:getNestedContainerLinksParentContainerAsUp
    :testName "GET nested container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createNestedContainer
        _:getNestedContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:containerRepresentationHasIdProperty
    :testName "Container representation has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerId
    ) ;
    :assert [
        :that [
            :single [
                :variable "containerId" ;
            ] ;
        ] ;
        :matches [ :constant ".+" ] ;
    ] ;
.

_:containerRepresentationIdIsUriOfContainer
    :testName "Container representation id is URI of container" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerId
    ) ;
    :assert [
        :that [
            :base _:container ;
            :relative [
                :single [
                    :variable "containerId" ;
                ] ;
            ] ;
        ] ;
        :equals _:container ;
    ] ;
.

_:containerRepresentationTypeIsContainer
    :testName "Container representation type is Container" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerType
    ) ;
    :assert [
        :that [
            :single [
                :variable "containerType" ;
            ] ;
        ] ;
        :equals [ :constant "Container" ] ;
    ] ;
.

# Steps
_:getStorageDescriptionId
    :stepName "Get storage description id" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.id" ;
            :to "id" ;
        ]
    ) ;
.

_:getStorageDescriptionType
    :stepName "Get storage description type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionServices
    :stepName "Get storage description services" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[*]" ;
            :to "services" ;
        ]
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot' || @.type[?@ == 'StorageRoot']].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:getTextResourceStorageLinks
    :stepName "Get text resource storage links" ;
    :request _:getTextResource ;
    :extract (
        _:storageLinks
    ) ;
.

_:getContainerStorageLinks
    :stepName "Get container storage links" ;
    :request _:getContainer ;
    :extract (
        _:storageLinks
    ) ;
.

_:headTextResourceStorageLinks
    :stepName "Head text resource storage links" ;
    :request _:headTextResource ;
    :extract (
        _:storageLinks
    ) ;
.

_:headContainerStorageLinks
    :stepName "Head container storage links" ;
    :request _:headContainer ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageDescriptionStorageLinks
    :stepName "Get storage description storage links" ;
    :request _:getStorageDescription ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageDescriptionStatus
    :stepName "Get storage description status" ;
    :request _:getStorageDescription ;
    :extract (
        _:status
    ) ;
.

_:getStorageDescriptionContentType
    :stepName "Get storage description Content-Type" ;
    :request _:getStorageDescription ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageDescriptionAsCidContentType
    :stepName "Get storage description as CID Content-Type" ;
    :request _:getStorageDescriptionAsCid ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageRootType
    :stepName "Get storage root type" ;
    :request _:getStorageRoot ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionAsCidContext
    :stepName "Get storage description as CID context" ;
    :request _:getStorageDescriptionAsCid ;
    :extract (
        [
            :path "$['@context']" ;
            :to "context" ;
        ]
    ) ;
.

_:headStorageDescriptionStorageLinks
    :stepName "Head storage description storage links" ;
    :request _:headStorageDescription ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageRootStorageLinks
    :stepName "Get storage root storage links" ;
    :request _:getStorageRoot ;
    :extract (
        _:storageLinks
    ) ;
.

_:headStorageRootStorageLinks
    :stepName "Head storage root storage links" ;
    :request _:headStorageRoot ;
    :extract (
        _:storageLinks
    ) ;
.

_:getTextResourceUpLinks
    :stepName "Get text resource up links" ;
    :request _:getTextResource ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerUpLinks
    :stepName "Get container up links" ;
    :request _:getContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:headTextResourceUpLinks
    :stepName "Head text resource up links" ;
    :request _:headTextResource ;
    :extract (
        _:upLinks
    ) ;
.

_:headContainerUpLinks
    :stepName "Head container up links" ;
    :request _:headContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerItemIds
    :stepName "Get container item ids" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.items[*].id" ;
            :to "itemIds" ;
        ]
    ) ;
.

_:createSecondTextResource
    :stepName "Create second text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        _:secondTextResourceLocation
    ) ;
.

_:deleteTextResource
    :stepName "Delete text resource" ;
    :request [
        :method "DELETE" ;
        :uri _:textResource ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:deleteContainer
    :stepName "Delete container" ;
    :request [
        :method "DELETE" ;
        :uri _:container ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:createNestedContainer
    :stepName "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:nestedContainerLocation
    ) ;
.

_:getNestedContainerUpLinks
    :stepName "Get nested container up links" ;
    :request _:getNestedContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerId
    :stepName "Get container id" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.id" ;
            :to "containerId" ;
        ]
    ) ;
.

_:getContainerType
    :stepName "Get container type" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.type" ;
            :to "containerType" ;
        ]
    ) ;
.

# Requests
_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:headTextResource
    :method "HEAD" ;
    :uri _:textResource ;
.

_:headContainer
    :method "HEAD" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getStorageDescriptionAsCid
    :method "GET" ;
    :uri _:storage ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/lws+cid" ] ;
    ] ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:headStorageDescription
    :method "HEAD" ;
    :uri _:storage ;
.

_:headStorageRoot
    :method "HEAD" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:getNestedContainer
    :method "GET" ;
    :uri _:nestedContainer ;
    :headers _:acceptLwsJson ;
.

# URIs
_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :base _:storage ;
    :relative [
        :single [
            :variable "storageRoot" ;
        ] ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:container ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:secondTextResource
    :base _:container ;
    :relative [
        :single [
            :variable "secondTextResourceLocation" ;
        ] ;
    ] ;
.

_:nestedContainer
    :base _:container ;
    :relative [
        :single [
            :variable "nestedContainerLocation" ;
        ] ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

# Extractors
_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:textResourceLocation
    :header "Location" ;
    :to "textResourceLocation" ;
.

_:storageLinks
    :link "https://www.w3.org/ns/lws#storage" ;
    :to "storageLinks" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.

_:secondTextResourceLocation
    :header "Location" ;
    :to "secondTextResourceLocation" ;
.

_:nestedContainerLocation
    :header "Location" ;
    :to "nestedContainerLocation" ;
.

# Assertions
_:storageLinkTargetsStorage
    :that [
        :variable "storageLinks" ;
    ] ;
    :contains _:storage ;
.

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+cid\\s*(;|$)" ] ;
.
