_:linksetIsDiscoverableViaLinkHeaderWithRelLinkset
    :testName "Linkset is discoverable via Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
