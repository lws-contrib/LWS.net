_:headNonRootContainerLinksParentContainerAsUp
    :testName "HEAD non-root container links parent container as up" ;
    :specification "https://www.w3.org/TR/lws10-core/#containment"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
