_:containerLinksetIsDiscoverableViaLinkHeaderWithRelLinkset
    :testName "Container linkset is discoverable via Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerLinksetLinks
    ) ;
    :assert _:linksetLink ;
.

_:linksetResourceIsAvailableAsApplicationLinksetJson
    :testName "Linkset resource is available as application/linkset+json" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetContentType
    ) ;
    :assert _:linksetJsonContentType ;
.

_:linksetResourceBodyIsRfc9264Linkset
    :testName "Linkset resource body is RFC 9264 linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetMembers
    ) ;
    :assert [
        :that [
            :count [
                :variable "linksetMembers" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:allowHeaderOfLinksetAdvertisesGet
    :testName "Allow header of linkset advertises GET" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:headLinksetAllow
    ) ;
    :assert [
        :that [
            :variable "allow" ;
        ] ;
        :contains [ :constant "GET" ] ;
    ] ;
.

_:allowHeaderOfLinksetAdvertisesPatch
    :testName "Allow header of linkset advertises PATCH" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:headLinksetAllow
    ) ;
    :assert [
        :that [
            :variable "allow" ;
        ] ;
        :contains [ :constant "PATCH" ] ;
    ] ;
.

_:acceptPatchHeaderOfLinksetAdvertisesJsonPatch
    :testName "Accept-Patch header of linkset advertises JSON Patch" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:headLinksetAcceptPatch
    ) ;
    :assert [
        :that [
            :single [
                :variable "acceptPatch" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)(^|,)\\s*application/json-patch\\+json\\s*(;[^,]*)?(,|$)" ] ;
    ] ;
.

_:linksetGetResponseIncludesEtagHeader
    :testName "Linkset GET response includes ETag header" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetEtag
    ) ;
    :assert _:entityTag ;
.

_:linksetHeadResponseIncludesEtagHeader
    :testName "Linkset HEAD response includes ETag header" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:headLinksetEtag
    ) ;
    :assert _:entityTag ;
.

_:linksetResourceSupportsPatchUsingApplicationJsonPatchJson
    :testName "Linkset resource supports PATCH using application/json-patch+json" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetEtag
        _:patchLinksetAddingDescribedBy
        _:getLinksetDescribedByHref
    ) ;
    :assert [
        :that [
            :single [
                :variable "describedByHref" ;
            ] ;
        ] ;
        :equals [ :constant "https://example.org/schema" ] ;
    ] ;
.

_:serverPreservesLinksClientIsNotPermittedToModifyWhenApplyingPatch
    :testName "Server preserves links client is not permitted to modify when applying patch" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetEtag
        _:patchLinksetRemovingType
        _:getLinksetTypeHrefs
    ) ;
    :assert [
        :that [
            :variable "typeHrefs" ;
        ] ;
        :contains [ :constant "https://www.w3.org/ns/lws#DataResource" ] ;
    ] ;
.

_:deletingResourceRemovesItsAssociatedLinksetResource
    :testName "Deleting resource removes its associated linkset resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:deleteTextResource
        _:getLinksetStatus
    ) ;
    :assert [
        :that [
            :variable "status" ;
        ] ;
        :matches [ :constant "^(404|410)$" ] ;
    ] ;
.

_:serverManagedMetadataIsGeneratedAutomaticallyUponCreation
    :testName "Server-managed metadata is generated automatically upon creation" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceLinksetLinks
        _:getLinksetUpHrefs
    ) ;
    :assert [
        :that [
            :count [
                :variable "upHrefs" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:serverManagedUpLinkIsNotOverriddenByClientProvidedLink
    :testName "Server-managed up link is not overridden by client-provided link" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceWithForgedUpLink
        _:getTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :single [
                :variable "upLinks" ;
            ] ;
        ] ;
        :equals _:container ;
    ] ;
.

_:serverManagedLinksetLinkIsNotOverriddenByClientProvidedLink
    :testName "Server-managed linkset link is not overridden by client-provided link" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceWithForgedLinksetLink
        _:getTextResourceLinksetLinks
        _:getLinksetBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :matches [ :constant "(?i)^(?![\\s\\S]*example\\.org\\\\?/evil)(?=[\\s\\S]*\"up\")" ] ;
    ] ;
.

_:successfulCreationReturns201StatusCode
    :testName "Successful creation returns 201 status code" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceStatus
    ) ;
    :assert _:201 ;
.

_:successfulCreationReturnsNewUriInLocationHeader
    :testName "Successful creation returns new URI in Location header" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
    ) ;
    :assert [
        :that [
            :single [
                :variable "textResourceLocation" ;
            ] ;
        ] ;
        :matches [ :constant "^\\S+$" ] ;
    ] ;
.

_:createdResourceCanBeRetrievedUsingGetOnItsNewUri
    :testName "Created resource can be retrieved using GET on its new URI" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStatus
    ) ;
    :assert _:200 ;
.

_:createResponseIncludesLinkHeaderWithRelUp
    :testName "Create response includes Link header with rel up" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :count [
                :variable "upLinks" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:createResponseLinkHeaderWithRelUpTargetsParentContainer
    :testName "Create response Link header with rel up targets parent container" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:container ;
    ] ;
.

_:createResponseIncludesLinkHeaderWithRelLinkset
    :testName "Create response includes Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceLinksetLinks
    ) ;
    :assert _:linksetLink ;
.

_:dataResourceIsCreatedWithContentFromRequestBody
    :testName "Data resource is created with content from request body" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceBody
    ) ;
    :assert [
        :that [
            :variable "body" ;
        ] ;
        :equals [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
.

_:postWithLinkHeaderWithRelTypeContainerCreatesContainer
    :testName "POST with Link header with rel type Container creates container" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerType
    ) ;
    :assert [
        :that [
            :single [
                :variable "containerType" ;
            ] ;
        ] ;
        :equals [ :constant "Container" ] ;
    ] ;
.

_:containerCreationResponseLinkRelUpTargetsParentContainer
    :testName "Container creation response Link rel up targets parent container" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainerUpLinks
    ) ;
    :assert [
        :that [
            :variable "upLinks" ;
        ] ;
        :contains _:storageRoot ;
    ] ;
.

_:containerCreationResponseIncludesLinkHeaderWithRelLinkset
    :testName "Container creation response includes Link header with rel linkset" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainerLinksetLinks
    ) ;
    :assert _:linksetLink ;
.

_:linksetResourceIsCreatedAndPopulatedBeforeReturningSuccess
    :testName "Linkset resource is created and populated before returning success" ;
    :specification "https://www.w3.org/TR/lws10-core/#create-resource"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResourceLinksetLinks
        _:getLinksetStatus
    ) ;
    :assert _:200 ;
.

# Steps
_:getStorageDescriptionId
    :stepName "Get storage description id" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.id" ;
            :to "id" ;
        ]
    ) ;
.

_:getStorageDescriptionType
    :stepName "Get storage description type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionServices
    :stepName "Get storage description services" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[*]" ;
            :to "services" ;
        ]
    ) ;
.

_:getServicesWhenAllHaveServiceEndpoint
    :stepName "Get services when all have serviceEndpoint" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?count($.service[?!@.serviceEndpoint]) == 0]" ;
            :to "servicesAllHavingServiceEndpoint" ;
        ]
    ) ;
.

_:getServicesWhenAllHaveType
    :stepName "Get services when all have type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?count($.service[?!@.type]) == 0]" ;
            :to "servicesAllHavingType" ;
        ]
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot' || @.type[?@ == 'StorageRoot']].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:getTextResourceStorageLinks
    :stepName "Get text resource storage links" ;
    :request _:getTextResource ;
    :extract (
        _:storageLinks
    ) ;
.

_:getContainerStorageLinks
    :stepName "Get container storage links" ;
    :request _:getContainer ;
    :extract (
        _:storageLinks
    ) ;
.

_:headTextResourceStorageLinks
    :stepName "Head text resource storage links" ;
    :request _:headTextResource ;
    :extract (
        _:storageLinks
    ) ;
.

_:headContainerStorageLinks
    :stepName "Head container storage links" ;
    :request _:headContainer ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageDescriptionStorageLinks
    :stepName "Get storage description storage links" ;
    :request _:getStorageDescription ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageDescriptionStatus
    :stepName "Get storage description status" ;
    :request _:getStorageDescription ;
    :extract (
        _:status
    ) ;
.

_:getStorageDescriptionContentType
    :stepName "Get storage description Content-Type" ;
    :request _:getStorageDescription ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageDescriptionAsCidContentType
    :stepName "Get storage description as CID Content-Type" ;
    :request _:getStorageDescriptionAsCid ;
    :extract (
        _:contentType
    ) ;
.

_:getStorageRootType
    :stepName "Get storage root type" ;
    :request _:getStorageRoot ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionAsCidContext
    :stepName "Get storage description as CID context" ;
    :request _:getStorageDescriptionAsCid ;
    :extract (
        [
            :path "$['@context']" ;
            :to "context" ;
        ]
    ) ;
.

_:headStorageDescriptionStorageLinks
    :stepName "Head storage description storage links" ;
    :request _:headStorageDescription ;
    :extract (
        _:storageLinks
    ) ;
.

_:getStorageRootStorageLinks
    :stepName "Get storage root storage links" ;
    :request _:getStorageRoot ;
    :extract (
        _:storageLinks
    ) ;
.

_:headStorageRootStorageLinks
    :stepName "Head storage root storage links" ;
    :request _:headStorageRoot ;
    :extract (
        _:storageLinks
    ) ;
.

_:getTextResourceUpLinks
    :stepName "Get text resource up links" ;
    :request _:getTextResource ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerUpLinks
    :stepName "Get container up links" ;
    :request _:getContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:headTextResourceUpLinks
    :stepName "Head text resource up links" ;
    :request _:headTextResource ;
    :extract (
        _:upLinks
    ) ;
.

_:headContainerUpLinks
    :stepName "Head container up links" ;
    :request _:headContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerItemIds
    :stepName "Get container item ids" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.items[*].id" ;
            :to "itemIds" ;
        ]
    ) ;
.

_:createSecondTextResource
    :stepName "Create second text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
    ] ;
    :extract (
        _:secondTextResourceLocation
    ) ;
.

_:deleteTextResource
    :stepName "Delete text resource" ;
    :request [
        :method "DELETE" ;
        :uri _:textResource ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:deleteContainer
    :stepName "Delete container" ;
    :request [
        :method "DELETE" ;
        :uri _:container ;
    ] ;
    :extract (
        _:status
    ) ;
.

_:createNestedContainer
    :stepName "Create nested container" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:nestedContainerLocation
    ) ;
.

_:getNestedContainerUpLinks
    :stepName "Get nested container up links" ;
    :request _:getNestedContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:getContainerId
    :stepName "Get container id" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.id" ;
            :to "containerId" ;
        ]
    ) ;
.

_:getContainerType
    :stepName "Get container type" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.type" ;
            :to "containerType" ;
        ]
    ) ;
.

_:getContainerTotalItems
    :stepName "Get container totalItems" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.totalItems" ;
            :to "totalItems" ;
        ]
    ) ;
.

_:getContainerItemsArray
    :stepName "Get container items array" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.items" ;
            :to "itemsArray" ;
        ]
    ) ;
.

_:getContainerItemTypes
    :stepName "Get container item types" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.items[*].type" ;
            :to "itemTypes" ;
        ]
    ) ;
.

_:getContainerItemFormats
    :stepName "Get container item formats" ;
    :request _:getContainer ;
    :extract (
        [
            :path "$.items[*].format" ;
            :to "itemFormats" ;
        ]
    ) ;
.

_:getTextResourceLinksetLinks
    :stepName "Get text resource linkset links" ;
    :request _:getTextResource ;
    :extract (
        _:linksetLinks
    ) ;
.

_:getLinksetStatus
    :stepName "Get linkset status" ;
    :request _:getLinkset ;
    :extract (
        _:status
    ) ;
.

_:getContainerLinksetLinks
    :stepName "Get container linkset links" ;
    :request _:getContainer ;
    :extract (
        _:linksetLinks
    ) ;
.

_:getLinksetContentType
    :stepName "Get linkset Content-Type" ;
    :request _:getLinkset ;
    :extract (
        _:contentType
    ) ;
.

_:getLinksetMembers
    :stepName "Get linkset members" ;
    :request _:getLinkset ;
    :extract (
        [
            :path "$.linkset[*]" ;
            :to "linksetMembers" ;
        ]
    ) ;
.

_:headLinksetAllow
    :stepName "Head linkset Allow" ;
    :request _:headLinkset ;
    :extract (
        _:allow
    ) ;
.

_:headLinksetAcceptPatch
    :stepName "Head linkset Accept-Patch" ;
    :request _:headLinkset ;
    :extract (
        _:acceptPatch
    ) ;
.

_:getLinksetEtag
    :stepName "Get linkset ETag" ;
    :request _:getLinkset ;
    :extract (
        _:etag
    ) ;
.

_:headLinksetEtag
    :stepName "Head linkset ETag" ;
    :request _:headLinkset ;
    :extract (
        _:etag
    ) ;
.

_:patchLinksetAddingDescribedBy
    :stepName "Patch linkset adding describedby" ;
    :request _:patchLinksetAddDescribedBy ;
    :extract (
        _:status
    ) ;
.

_:getLinksetDescribedByHref
    :stepName "Get linkset describedby href" ;
    :request _:getLinkset ;
    :extract (
        [
            :path "$.linkset[?(@.describedby)].describedby[0].href" ;
            :to "describedByHref" ;
        ]
    ) ;
.

_:patchLinksetRemovingType
    :stepName "Patch linkset removing type" ;
    :request _:patchLinksetRemoveType ;
    :extract (
        _:status
    ) ;
.

_:getLinksetTypeHrefs
    :stepName "Get linkset type hrefs" ;
    :request _:getLinkset ;
    :extract (
        [
            :path "$.linkset[*].type[*].href" ;
            :to "typeHrefs" ;
        ]
    ) ;
.

_:createTextResourceLinksetLinks
    :stepName "Create text resource linkset links" ;
    :request _:postTextResource ;
    :extract (
        _:linksetLinks
    ) ;
.

_:getLinksetUpHrefs
    :stepName "Get linkset up hrefs" ;
    :request _:getLinkset ;
    :extract (
        [
            :path "$.linkset[*].up[*].href" ;
            :to "upHrefs" ;
        ]
    ) ;
.

_:createTextResourceWithForgedUpLink
    :stepName "Create text resource with forged up link" ;
    :request _:postTextResourceWithForgedUpLink ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:createTextResourceWithForgedLinksetLink
    :stepName "Create text resource with forged linkset link" ;
    :request _:postTextResourceWithForgedLinksetLink ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:getLinksetBody
    :stepName "Get linkset body" ;
    :request _:getLinkset ;
    :extract (
        _:body
    ) ;
.

_:createTextResourceStatus
    :stepName "Create text resource status" ;
    :request _:postTextResource ;
    :extract (
        _:status
    ) ;
.

_:getTextResourceStatus
    :stepName "Get text resource status" ;
    :request _:getTextResource ;
    :extract (
        _:status
    ) ;
.

_:createTextResourceUpLinks
    :stepName "Create text resource up links" ;
    :request _:postTextResource ;
    :extract (
        _:upLinks
    ) ;
.

_:getTextResourceBody
    :stepName "Get text resource body" ;
    :request _:getTextResource ;
    :extract (
        _:body
    ) ;
.

_:createContainerUpLinks
    :stepName "Create container up links" ;
    :request _:postContainer ;
    :extract (
        _:upLinks
    ) ;
.

_:createContainerLinksetLinks
    :stepName "Create container linkset links" ;
    :request _:postContainer ;
    :extract (
        _:linksetLinks
    ) ;
.

# Requests
_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:headTextResource
    :method "HEAD" ;
    :uri _:textResource ;
.

_:headContainer
    :method "HEAD" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

_:getStorageDescriptionAsCid
    :method "GET" ;
    :uri _:storage ;
    :headers [
        :key "Accept" ;
        :value [ :constant "application/lws+cid" ] ;
    ] ;
.

_:getStorageRoot
    :method "GET" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:headStorageDescription
    :method "HEAD" ;
    :uri _:storage ;
.

_:headStorageRoot
    :method "HEAD" ;
    :uri _:storageRoot ;
    :headers _:acceptLwsJson ;
.

_:getNestedContainer
    :method "GET" ;
    :uri _:nestedContainer ;
    :headers _:acceptLwsJson ;
.

_:getLinkset
    :method "GET" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

_:headLinkset
    :method "HEAD" ;
    :uri _:linkset ;
    :headers _:acceptLinksetJson ;
.

_:patchLinksetAddDescribedBy
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers _:ifMatchEtag ;
    :body [ :constant "[{\"op\":\"add\",\"path\":\"/linkset/0/describedby\",\"value\":[{\"href\":\"https://example.org/schema\"}]}]" ] ;
.

_:patchLinksetRemoveType
    :method "PATCH" ;
    :uri _:linkset ;
    :headers _:contentTypeJsonPatch ;
    :headers _:ifMatchEtag ;
    :body [ :constant "[{\"op\":\"remove\",\"path\":\"/linkset/0/type\"}]" ] ;
.

_:postTextResource
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postTextResourceWithForgedUpLink
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :headers _:linkForgedUp ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postTextResourceWithForgedLinksetLink
    :method "POST" ;
    :uri _:container ;
    :headers _:contentTypeTextPlain ;
    :headers _:linkForgedLinkset ;
    :body [ :constant "milk\neggs\nbread\nbutter\napples\norange juice\n" ] ;
.

_:postContainer
    :method "POST" ;
    :uri _:storageRoot ;
    :headers _:linkTypeContainer ;
.

# URIs
_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :base _:storage ;
    :relative [
        :single [
            :variable "storageRoot" ;
        ] ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:container ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

_:secondTextResource
    :base _:container ;
    :relative [
        :single [
            :variable "secondTextResourceLocation" ;
        ] ;
    ] ;
.

_:nestedContainer
    :base _:container ;
    :relative [
        :single [
            :variable "nestedContainerLocation" ;
        ] ;
    ] ;
.

_:linkset
    :single [
        :variable "linksetLinks" ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

_:acceptLinksetJson
    :key "Accept" ;
    :value [ :constant "application/linkset+json" ] ;
.

_:contentTypeJsonPatch
    :key "Content-Type" ;
    :value [ :constant "application/json-patch+json" ] ;
.

_:ifMatchEtag
    :key "If-Match" ;
    :value [
        :single [
            :variable "etag" ;
        ] ;
    ] ;
.

_:linkForgedUp
    :key "Link" ;
    :value [ :constant "<https://example.org/evil>; rel=\"up\"" ] ;
.

_:linkForgedLinkset
    :key "Link" ;
    :value [ :constant "<https://example.org/evil>; rel=\"linkset\"" ] ;
.

# Extractors
_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:textResourceLocation
    :header "Location" ;
    :to "textResourceLocation" ;
.

_:storageLinks
    :link "https://www.w3.org/ns/lws#storage" ;
    :to "storageLinks" ;
.

_:status
    a :StatusCodeExtractor ;
    :to "status" ;
.

_:contentType
    :header "Content-Type" ;
    :to "contentType" ;
.

_:upLinks
    :link "up" ;
    :to "upLinks" ;
.

_:secondTextResourceLocation
    :header "Location" ;
    :to "secondTextResourceLocation" ;
.

_:nestedContainerLocation
    :header "Location" ;
    :to "nestedContainerLocation" ;
.

_:linksetLinks
    :link "linkset" ;
    :to "linksetLinks" ;
.

_:allow
    :header "Allow" ;
    :to "allow" ;
.

_:acceptPatch
    :header "Accept-Patch" ;
    :to "acceptPatch" ;
.

_:etag
    :header "ETag" ;
    :to "etag" ;
.

_:body
    a :BodyExtractor ;
    :to "body" ;
.

# Assertions
_:storageLinkTargetsStorage
    :that [
        :variable "storageLinks" ;
    ] ;
    :contains _:storage ;
.

_:200
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "200" ] ;
.

_:lwsCidContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/lws\\+cid\\s*(;|$)" ] ;
.

_:linksetLink
    :that [
        :count [
            :variable "linksetLinks" ;
        ] ;
    ] ;
    :greaterThan [ :constant 0 ] ;
.

_:linksetJsonContentType
    :that [
        :single [
            :variable "contentType" ;
        ] ;
    ] ;
    :matches [ :constant "(?i)^application/linkset\\+json\\s*(;|$)" ] ;
.

_:entityTag
    :that [
        :single [
            :variable "etag" ;
        ] ;
    ] ;
    :matches [ :constant "^(W/)?\"[^\"]*\"$" ] ;
.

_:201
    :that [
        :variable "status" ;
    ] ;
    :equals [ :constant "201" ] ;
.
