            :single [
                :variable "containerType" ;
            ] ;
        ] ;
        :equals [ :constant "Container" ] ;
    ] ;
.

_:containerRepresentationTotalItemsIsInteger
    :testName "Container representation totalItems is integer" ;
    :specification "https://www.w3.org/TR/lws10-core/#container-properties"^^xsd:anyURI ;
    :steps (
