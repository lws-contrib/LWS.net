@prefix : <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    :manifestName "From specification: Linked Web Storage Protocol 1.0" ;
    :test
        _:storageDescriptionHasIdProperty ,
        _:storageDescriptionIdIsCanonicalStorageUri ,
        _:storageDescriptionHasTypeProperty ,
        _:storageDescriptionTypeIsOrContainsStorage ,
        _:storageDescriptionHasServiceProperty ,
        _:storageDescriptionServicesContainStorageRoot ,
        _:storageRootServiceEndpointIsUri ,
        _:getDataResourceLinksStorage ,
        _:getContainerLinksStorage ;
] .

# Tests

_:storageDescriptionHasIdProperty
    :testName "Storage description has id property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :single [
                :variable "id" ;
            ] ;
        ] ;
        :matches [ :constant "^[A-Za-z][A-Za-z0-9+.-]*:" ] ;
    ] ;
.

_:storageDescriptionIdIsCanonicalStorageUri
    :testName "Storage description id is canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionId
    ) ;
    :assert [
        :that [
            :base _:storage ;
            :relative [
                :single [
                    :variable "id" ;
                ] ;
            ] ;
        ] ;
        :equals _:storage ;
    ] ;
.

_:storageDescriptionHasTypeProperty
    :testName "Storage description has type property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^(?!\\[\\s*\\]$).+" ] ;
    ] ;
.

_:storageDescriptionTypeIsOrContainsStorage
    :testName "Storage description type equals or contains Storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionType
    ) ;
    :assert [
        :that [
            :single [
                :variable "type" ;
            ] ;
        ] ;
        :matches [ :constant "^Storage$|\"Storage\"" ] ;
    ] ;
.

_:storageDescriptionHasServiceProperty
    :testName "Storage description has service property" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:getStorageDescriptionServices
    ) ;
    :assert [
        :that [
            :count [
                :variable "services" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageDescriptionServicesContainStorageRoot
    :testName "Storage description services contain StorageRoot" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-services"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :count [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :greaterThan [ :constant 0 ] ;
    ] ;
.

_:storageRootServiceEndpointIsUri
    :testName "StorageRoot serviceEndpoint is URI" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-data-model"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
    ) ;
    :assert [
        :that [
            :single [
                :variable "storageRoot" ;
            ] ;
        ] ;
        :matches [ :constant "^https?://.+" ] ;
    ] ;
.

_:getDataResourceLinksStorage
    :testName "GET data resource links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

_:getContainerLinksStorage
    :testName "GET container links canonical URI of storage" ;
    :specification "https://www.w3.org/TR/lws10-core/#storage-description-binding"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:getContainerStorageLinks
    ) ;
    :assert _:storageLinkTargetsStorage ;
.

# Steps
_:getStorageDescriptionId
    :stepName "Get storage description id" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.id" ;
            :to "id" ;
        ]
    ) ;
.

_:getStorageDescriptionType
    :stepName "Get storage description type" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.type" ;
            :to "type" ;
        ]
    ) ;
.

_:getStorageDescriptionServices
    :stepName "Get storage description services" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[*]" ;
            :to "services" ;
        ]
    ) ;
.

_:discoverStorageRoot
    :stepName "Discover storage root" ;
    :request _:getStorageDescription ;
    :extract (
        [
            :path "$.service[?@.type == 'StorageRoot' || @.type[?@ == 'StorageRoot']].serviceEndpoint" ;
            :to "storageRoot" ;
        ]
    ) ;
.

_:createContainer
    :stepName "Create container" ;
    :request [
        :method "POST" ;
        :uri _:storageRoot ;
        :headers _:linkTypeContainer ;
    ] ;
    :extract (
        _:containerLocation
    ) ;
.

_:createTextResource
    :stepName "Create text resource" ;
    :request [
        :method "POST" ;
        :uri _:container ;
        :headers _:contentTypeTextPlain ;
        :body "milk\neggs\nbread\nbutter\napples\norange juice\n" ;
    ] ;
    :extract (
        _:textResourceLocation
    ) ;
.

_:getTextResourceStorageLinks
    :stepName "Get text resource storage links" ;
    :request _:getTextResource ;
    :extract (
        _:storageLinks
    ) ;
.

_:getContainerStorageLinks
    :stepName "Get container storage links" ;
    :request _:getContainer ;
    :extract (
        _:storageLinks
    ) ;
.

# Requests
_:getStorageDescription
    :method "GET" ;
    :uri _:storage ;
.

_:getTextResource
    :method "GET" ;
    :uri _:textResource ;
.

_:getContainer
    :method "GET" ;
    :uri _:container ;
    :headers _:acceptLwsJson ;
.

# URIs
_:storage
    :variable "baseUri" ;
.

_:storageRoot
    :base _:storage ;
    :relative [
        :single [
            :variable "storageRoot" ;
        ] ;
    ] ;
.

_:container
    :base _:storageRoot ;
    :relative [
        :single [
            :variable "containerLocation" ;
        ] ;
    ] ;
.

_:textResource
    :base _:container ;
    :relative [
        :single [
            :variable "textResourceLocation" ;
        ] ;
    ] ;
.

# Headers
_:linkTypeContainer
    :key "Link" ;
    :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
.

_:contentTypeTextPlain
    :key "Content-Type" ;
    :value [ :constant "text/plain" ] ;
.

_:acceptLwsJson
    :key "Accept" ;
    :value [ :constant "application/lws+json" ] ;
.

# Extractors
_:containerLocation
    :header "Location" ;
    :to "containerLocation" ;
.

_:textResourceLocation
    :header "Location" ;
    :to "textResourceLocation" ;
.

_:storageLinks
    :link "https://www.w3.org/ns/lws#storage" ;
    :to "storageLinks" ;
.

# Assertions
_:storageLinkTargetsStorage
    :that [
        :variable "storageLinks" ;
    ] ;
    :contains _:storage ;
.
