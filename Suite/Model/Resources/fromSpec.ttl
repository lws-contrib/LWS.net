_:containedDataResourceDescriptionFormatIsMediaTypeOfDataResource
    :testName "Contained data resource description format is media type of data resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#contained-resource-description"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getContainerItemFormats
    ) ;
    :assert [
        :that [
            :single [
                :variable "itemFormats" ;
            ] ;
        ] ;
        :matches [ :constant "(?i)^text/plain\\s*(;|$)" ] ;
    ] ;
.

_:metadataLinksAreAvailableAsStandaloneResource
    :testName "Metadata links are available as a standalone resource" ;
    :specification "https://www.w3.org/TR/lws10-core/#metadata-0"^^xsd:anyURI ;
    :steps (
        _:discoverStorageRoot
        _:createContainer
        _:createTextResource
        _:getTextResourceLinksetLinks
        _:getLinksetStatus
    ) ;
