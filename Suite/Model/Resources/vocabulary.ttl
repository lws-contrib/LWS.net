@prefix : <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Properties

:manifestName
    a rdf:Property ;
    rdfs:label "manifest name"@en ;
    rdfs:comment "Human-readable name of the manifest, shown alongside the names of its test cases."@en ;
    rdfs:domain :Manifest ;
    rdfs:range xsd:string ;
.

:include
    a rdf:Property ;
    rdfs:label "include"@en ;
    rdfs:comment "Reference to another manifest whose test cases are run as part of this manifest. A relative reference is resolved against the base URI of the including document."@en ;
    rdfs:domain :Manifest ;
    rdfs:range xsd:anyURI ;
.

:test
    a rdf:Property ;
    rdfs:label "test"@en ;
    rdfs:comment "A test case of the manifest. Test cases are independent of each other and have no order."@en ;
    rdfs:domain :Manifest ;
    rdfs:range :TestCase ;
.

:testName
    a rdf:Property ;
    rdfs:label "test name"@en ;
    rdfs:comment "Human-readable name of the test case, identifying it in test runs and reports."@en ;
    rdfs:domain :TestCase ;
    rdfs:range xsd:string ;
.

:steps
    a rdf:Property ;
    rdfs:label "steps"@en ;
    rdfs:comment "Ordered list of the steps of the test case, executed one after the other before its assertion is evaluated. Each item is a step."@en ;
    rdfs:domain :TestCase ;
    rdfs:range rdf:List ;
.

:assert
    a rdf:Property ;
    rdfs:label "assert"@en ;
    rdfs:comment "Assertion evaluated once all steps of the test case have been executed. Its result is the outcome of the test case."@en ;
    rdfs:domain :TestCase ;
    rdfs:range :Assertion ;
.

:stepName
    a rdf:Property ;
    rdfs:label "step name"@en ;
    rdfs:comment "Human-readable name of the step, identifying it in traces."@en ;
    rdfs:domain :Step ;
    rdfs:range xsd:string ;
.

:request
    a rdf:Property ;
    rdfs:label "request"@en ;
    rdfs:comment "HTTP request sent by the step. Its response is passed to the extractors of the step."@en ;
    rdfs:domain :Step ;
    rdfs:range :Request ;
.

:extract
    a rdf:Property ;
    rdfs:label "extract"@en ;
    rdfs:comment "Ordered list of extractors applied one after the other to the response of the request of the step. Each item is an extractor."@en ;
    rdfs:domain :Step ;
    rdfs:range rdf:List ;
.

:method
    a rdf:Property ;
    rdfs:label "method"@en ;
    rdfs:comment "HTTP method of the request, such as GET, HEAD, POST or DELETE."@en ;
    rdfs:domain :Request ;
    rdfs:range xsd:string ;
.

:uri
    a rdf:Property ;
    rdfs:label "URI"@en ;
    rdfs:comment "Expression evaluating to the target URI of the request, which must be absolute."@en ;
    rdfs:domain :Request ;
    rdfs:range :Expression ;
.

:headers
    a rdf:Property ;
    rdfs:label "headers"@en ;
    rdfs:comment "A header field sent with the request. Content header fields, such as Content-Type, are only sent when the request has a body."@en ;
    rdfs:domain :Request ;
    rdfs:range :RequestHeader ;
.

:body
    a rdf:Property ;
    rdfs:label "body"@en ;
    rdfs:comment "Content of the request, sent as UTF-8 text. No media type is sent unless a Content-Type header field is given."@en ;
    rdfs:domain :Request ;
    rdfs:range xsd:string ;
.

:key
    a rdf:Property ;
    rdfs:label "key"@en ;
    rdfs:comment "Name of the header field."@en ;
    rdfs:domain :RequestHeader ;
    rdfs:range xsd:string ;
.

:value
    a rdf:Property ;
    rdfs:label "value"@en ;
    rdfs:comment "Expression evaluating to the value of the header field, which must be a string."@en ;
    rdfs:domain :RequestHeader ;
    rdfs:range :Expression ;
.

:to
    a rdf:Property ;
    rdfs:label "to"@en ;
    rdfs:comment "Name of the variable in which the extracted value is stored, replacing any earlier value. Variables last for the duration of a test case."@en ;
    rdfs:domain :Extractor ;
    rdfs:range xsd:string ;
.

:header
    a rdf:Property ;
    rdfs:label "header"@en ;
    rdfs:comment "Name of the response header field whose values are extracted as a list of strings. The field must be present."@en ;
    rdfs:domain :HeaderExtractor ;
    rdfs:range xsd:string ;
.

:path
    a rdf:Property ;
    rdfs:label "path"@en ;
    rdfs:comment "JSONPath query that must select exactly one value from the JSON body of the response. A selected string is extracted as its content, any other value as JSON text."@en ;
    rdfs:domain :JsonPathExtractor ;
    rdfs:range xsd:string ;
.

:link
    a rdf:Property ;
    rdfs:label "link"@en ;
    rdfs:comment "Link relation type. The targets of the links in the Link header fields of the response that have this relation type are extracted as a list of absolute URIs, resolved against the request URI. A relation type containing a colon is an extension relation type and matches exactly, any other matches case-insensitively."@en ;
    rdfs:domain :LinkExtractor ;
    rdfs:range xsd:string ;
.

:constant
    a rdf:Property ;
    rdfs:label "constant"@en ;
    rdfs:comment "String the constant expression evaluates to."@en ;
    rdfs:domain :ConstantExpression ;
    rdfs:range xsd:string ;
.

:variable
    a rdf:Property ;
    rdfs:label "variable"@en ;
    rdfs:comment "Name of the variable whose value the expression evaluates to. The variable must have been set, either by an earlier extractor or, for baseUri, to the base URI of the server under test."@en ;
    rdfs:domain :VariableExpression ;
    rdfs:range xsd:string ;
.

:base
    a rdf:Property ;
    rdfs:label "base"@en ;
    rdfs:comment "Expression evaluating to the absolute URI against which the reference is resolved."@en ;
    rdfs:domain :ResolveExpression ;
    rdfs:range :Expression ;
.

:relative
    a rdf:Property ;
    rdfs:label "relative"@en ;
    rdfs:comment "Expression evaluating to the URI reference resolved against the base URI."@en ;
    rdfs:domain :ResolveExpression ;
    rdfs:range :Expression ;
.

:single
    a rdf:Property ;
    rdfs:label "single"@en ;
    rdfs:comment "Expression evaluating to a list of strings that must have exactly one item, which the single expression evaluates to."@en ;
    rdfs:domain :SingleExpression ;
    rdfs:range :Expression ;
.

:count
    a rdf:Property ;
    rdfs:label "count"@en ;
    rdfs:comment "Expression evaluating to a list of strings, whose number of items the count expression evaluates to."@en ;
    rdfs:domain :CountExpression ;
    rdfs:range :Expression ;
.

:that
    a rdf:Property ;
    rdfs:label "that"@en ;
    rdfs:comment "Expression whose value the assertion tests."@en ;
    rdfs:domain :Assertion ;
    rdfs:range :Expression ;
.

:equals
    a rdf:Property ;
    rdfs:label "equals"@en ;
    rdfs:comment "String the value must equal exactly. The value must be a string."@en ;
    rdfs:domain :EqualityAssertion ;
    rdfs:range xsd:string ;
.

:matches
    a rdf:Property ;
    rdfs:label "matches"@en ;
    rdfs:comment ".NET regular expression the value must match. The value must be a string. The match is case-sensitive and may occur anywhere in the value unless the expression says otherwise, for example with (?i), ^ or $."@en ;
    rdfs:domain :RegexAssertion ;
    rdfs:range xsd:string ;
.

:contains
    a rdf:Property ;
    rdfs:label "contains"@en ;
    rdfs:comment "String one of the items of the value must equal exactly. The value must be a list of strings."@en ;
    rdfs:domain :ContainsAssertion ;
    rdfs:range xsd:string ;
.

:greaterThan
    a rdf:Property ;
    rdfs:label "greater than"@en ;
    rdfs:comment "Integer the value must be greater than. The value must be an integer, such as the result of a count expression."@en ;
    rdfs:domain :GreaterThanAssertion ;
    rdfs:range xsd:integer ;
.

# Classes

:Manifest
    a rdfs:Class ;
    rdfs:label "Manifest"@en ;
    rdfs:comment "Named collection of test cases, possibly including other manifests. A manifest document describes exactly one manifest."@en ;
.

:TestCase
    a rdfs:Class ;
    rdfs:label "Test case"@en ;
    rdfs:comment "Sequence of steps followed by an assertion. Each test case starts with only the variable baseUri set."@en ;
.

:Step
    a rdfs:Class ;
    rdfs:label "Step"@en ;
    rdfs:comment "HTTP request whose response is processed by extractors."@en ;
.

:Request
    a rdfs:Class ;
    rdfs:label "Request"@en ;
    rdfs:comment "HTTP request."@en ;
.

:RequestHeader
    a rdfs:Class ;
    rdfs:label "Request header"@en ;
    rdfs:comment "HTTP header field sent with a request."@en ;
.

:Extractor
    a rdfs:Class ;
    rdfs:label "Extractor"@en ;
    rdfs:comment "Extracts a value from a response and stores it in a variable."@en ;
.

:BodyExtractor
    a rdfs:Class ;
    rdfs:subClassOf :Extractor ;
    rdfs:label "Body extractor"@en ;
    rdfs:comment "Extracts the body of the response as a string. Recognised by its type, as it has no property of its own."@en ;
.

:StatusCodeExtractor
    a rdfs:Class ;
    rdfs:subClassOf :Extractor ;
    rdfs:label "Status code extractor"@en ;
    rdfs:comment "Extracts the status code of the response as a string, such as 200. Recognised by its type, as it has no property of its own."@en ;
.

:HeaderExtractor
    a rdfs:Class ;
    rdfs:subClassOf :Extractor ;
    rdfs:label "Header extractor"@en ;
    rdfs:comment "Extracts the values of a response header field."@en ;
.

:LinkExtractor
    a rdfs:Class ;
    rdfs:subClassOf :Extractor ;
    rdfs:label "Link extractor"@en ;
    rdfs:comment "Extracts the targets of the links of the response that have a relation type."@en ;
.

:JsonPathExtractor
    a rdfs:Class ;
    rdfs:subClassOf :Extractor ;
    rdfs:label "JSONPath extractor"@en ;
    rdfs:comment "Extracts a value from the JSON body of the response."@en ;
.

:Expression
    a rdfs:Class ;
    rdfs:label "Expression"@en ;
    rdfs:comment "Evaluates to a string, a list of strings or an integer."@en ;
.

:ConstantExpression
    a rdfs:Class ;
    rdfs:subClassOf :Expression ;
    rdfs:label "Constant expression"@en ;
    rdfs:comment "Evaluates to a constant string."@en ;
.

:VariableExpression
    a rdfs:Class ;
    rdfs:subClassOf :Expression ;
    rdfs:label "Variable expression"@en ;
    rdfs:comment "Evaluates to the value of a variable."@en ;
.

:ResolveExpression
    a rdfs:Class ;
    rdfs:subClassOf :Expression ;
    rdfs:label "Resolve expression"@en ;
    rdfs:comment "Evaluates to a URI reference resolved against a base URI."@en ;
.

:SingleExpression
    a rdfs:Class ;
    rdfs:subClassOf :Expression ;
    rdfs:label "Single expression"@en ;
    rdfs:comment "Evaluates to the only item of a list of strings."@en ;
.

:CountExpression
    a rdfs:Class ;
    rdfs:subClassOf :Expression ;
    rdfs:label "Count expression"@en ;
    rdfs:comment "Evaluates to the number of items in a list of strings."@en ;
.

:Assertion
    a rdfs:Class ;
    rdfs:label "Assertion"@en ;
    rdfs:comment "Tests the value of an expression, passing or failing the test case."@en ;
.

:EqualityAssertion
    a rdfs:Class ;
    rdfs:subClassOf :Assertion ;
    rdfs:label "Equality assertion"@en ;
    rdfs:comment "Passes when the value equals a string."@en ;
.

:RegexAssertion
    a rdfs:Class ;
    rdfs:subClassOf :Assertion ;
    rdfs:label "Regular expression assertion"@en ;
    rdfs:comment "Passes when the value matches a regular expression."@en ;
.

:ContainsAssertion
    a rdfs:Class ;
    rdfs:subClassOf :Assertion ;
    rdfs:label "Contains assertion"@en ;
    rdfs:comment "Passes when one of the items of the value equals a string."@en ;
.

:GreaterThanAssertion
    a rdfs:Class ;
    rdfs:subClassOf :Assertion ;
    rdfs:label "Greater than assertion"@en ;
    rdfs:comment "Passes when the value is greater than an integer."@en ;
.
