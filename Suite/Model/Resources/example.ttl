@prefix : <http://example.com/> .

[
    :name "Example" ;
    :tests [
        :name "Delete returns 999 (intentionally failing)" ;
        :steps (
            [
                :name "Discover storage root" ;
                :request [
                    :method "GET" ;
                    :uri [
                        :base [
                            :variable "baseUri" ;
                        ] ;
                        :relative [
                            :constant "/" ;
                        ] ;
                    ] ;
                ] ;
                :extractors (
                    [
                        :to "storageRoot" ;
                        :path "$.service[?@.type == 'StorageRoot'].serviceEndpoint" ;
                    ]
                ) ;
            ]
            [
                :name "Create resource" ;
                :request [
                    :method "POST" ;
                    :uri [
                        :variable "storageRoot" ;
                    ] ;
                ] ;
                :extractors (
                    [
                        :to "newResource" ;
                        :header "Location" ;
                    ]
                ) ;
            ]
            [
                :name "Delete resource" ;
                :request [
                    :method "DELETE" ;
                    :uri [
                        :single [
                            :variable "newResource" ;
                        ] ;
                    ] ;
                ] ;
                :extractors (
                    [
                        a :StatusCodeExtractor ;
                        :to "status" ;
                    ]
                ) ;
            ]
        ) ;
        :assertion [
            :input [
                :variable "status" ;
            ] ;
            :equals "999" ;
        ] ;
    ] ;
] .
