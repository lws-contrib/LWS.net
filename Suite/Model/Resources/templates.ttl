@prefix : <http://example.com/> .
@prefix p: <urn:lws:param:> .

:CreateContainer
    a :StepTemplate ;
    :parameter (
        [ :parameterName "in" ; :required true ]
        [ :parameterName "as" ; :default "containerLocation" ]
    ) ;
    :expansion [
        :request [
            :method "POST" ;
            :uri p:in ;
            :headers [
                :key "Link" ;
                :value [ :constant "<https://www.w3.org/ns/lws#Container>; rel=\"type\"" ] ;
            ] ;
        ] ;
        :extract (
            [ :header "Location" ; :to [ :param "as" ] ]
        ) ;
    ] ;
.

:CreateResource
    a :StepTemplate ;
    :parameter (
        [ :parameterName "in" ; :required true ]
        [ :parameterName "contentType" ; :required true ]
        [ :parameterName "body" ; :required true ]
        [ :parameterName "as" ; :default "resourceLocation" ]
    ) ;
    :expansion [
        :request [
            :method "POST" ;
            :uri p:in ;
            :headers [
                :key "Content-Type" ;
                :value [ :constant [ :param "contentType" ] ] ;
            ] ;
            :body [ :constant [ :param "body" ] ] ;
        ] ;
        :extract (
            [ :header "Location" ; :to [ :param "as" ] ]
        ) ;
    ] ;
.

:DeleteResource
    a :StepTemplate ;
    :parameter (
        [ :parameterName "target" ; :required true ]
        [ :parameterName "as" ; :default "status" ]
    ) ;
    :expansion [
        :request [
            :method "DELETE" ;
            :uri p:target ;
        ] ;
        :extract (
            [ a :StatusCodeExtractor ; :to [ :param "as" ] ]
        ) ;
    ] ;
.
